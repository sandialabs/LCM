# Exodiff command file for DislocationDensityTwoFamilies. Tolerances follow
# DislocationDensityHardening.exodiff.

COORDINATES absolute 1.e-6

TIME STEPS relative 1.e-6 floor 0.0

NODAL VARIABLES relative 1.e-6 floor 1e-9
	displacement_x
	displacement_y
	displacement_z
	dirichlet_field_1
	dirichlet_field_2
	dirichlet_field_3
	force_x
