#!/bin/bash
# LCM Build System CLI
# Usage: lcm <command> [package] [threads]
#   lcm clean trilinos        - Clean trilinos build/install
#   lcm clean lcm             - Clean lcm build
#   lcm config trilinos [N]   - Configure trilinos
#   lcm config lcm [N]        - Configure lcm
#   lcm build trilinos [N]    - Build trilinos with N threads
#   lcm build lcm [N]         - Build lcm with N threads
#   lcm test lcm              - Run lcm tests
#   lcm all [N]               - Full pipeline: clean + config + build + test
#   lcm help                  - Show this help

set -e

#---------------------------------------------------------------------------
# Resolve LCM_DIR: workspace root that contains the LCM repo directory.
# If LCM_DIR is already set, honour it; otherwise derive from script path
# or fall back to the current working directory.
#---------------------------------------------------------------------------
if [ -z "$LCM_DIR" ]; then
    # Script lives in <workspace>/LCM/doc/lcm/build/lcm
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    CANDIDATE="$(cd "$SCRIPT_DIR/../../../../.." && pwd)"
    if [ -d "$CANDIDATE/LCM/doc/lcm" ]; then
        export LCM_DIR="$CANDIDATE"
    else
        export LCM_DIR="$(pwd)"
    fi
fi

#---------------------------------------------------------------------------
# Module environment
#---------------------------------------------------------------------------
MODULE_NAME="${LCM_MODULE:-release}"
export MODULEPATH="$LCM_DIR/LCM/doc/lcm/modulefiles${MODULEPATH:+:$MODULEPATH}"

# Source the module init if 'module' is not already a function/command
if ! type module &>/dev/null; then
    if [ -f /usr/share/Modules/init/bash ]; then
        source /usr/share/Modules/init/bash
    elif [ -f /usr/share/modules/init/bash ]; then
        source /usr/share/modules/init/bash
    elif [ -f /etc/profile.d/modules.sh ]; then
        source /etc/profile.d/modules.sh
    else
        echo "ERROR: Cannot find Environment Modules init script."
        echo "Install environment-modules or set module paths manually."
        exit 1
    fi
fi

#---------------------------------------------------------------------------
# Publish the recorded toolchain under the names the LCM modulefiles and the
# CMake configure read. Called once when the toolchain is first discovered and
# again after every 'module purge' + 'module load', which is what makes it
# survive a modulefile that owns one of these names. A no-op where no toolchain
# was recorded (every platform whose modulefiles set these themselves).
#---------------------------------------------------------------------------
restore_toolchain() {
    [ -n "${LCM_TOOLCHAIN_MPI_BIN:-}" ] || return 0
    export PATH="$LCM_TOOLCHAIN_PATH:$PATH"
    export LD_LIBRARY_PATH="$LCM_TOOLCHAIN_LD_LIBRARY_PATH:${LD_LIBRARY_PATH:-}"
    export CC="$LCM_TOOLCHAIN_CC"
    export CXX="$LCM_TOOLCHAIN_CXX"
    export FC="$LCM_TOOLCHAIN_FC"
    export OMPI_CC="$CC"
    export OMPI_CXX="$CXX"
    export OMPI_FC="$FC"
    export MPI_BIN="$LCM_TOOLCHAIN_MPI_BIN"
    export MPI_INC="$MPI_BIN/../include"
    export MPI_LIB="$MPI_BIN/../lib"
    export BOOST_ROOT="$LCM_TOOLCHAIN_BOOST_ROOT"
    export BOOST_INC="$BOOST_ROOT/include"
    export BOOST_LIB="$BOOST_ROOT/lib"
    export BOOSTLIB_INC="$BOOST_ROOT/include"
    export BOOSTLIB_LIB="$BOOST_ROOT/lib"
    export NETCDF="$LCM_TOOLCHAIN_NETCDF_ROOT"
    export NETCDF_INC="$NETCDF/include"
    export NETCDF_LIB="$NETCDF/lib"
}

#---------------------------------------------------------------------------
# Check that the toolchain the configure is about to use actually exists.
#
# Without this an unset MPI_BIN reaches CMake as the compiler path '/mpicxx'
# and the run dies a hundred lines later inside the Albany configure, saying
# nothing about where the path came from. Fail here instead, naming what is
# missing.
#---------------------------------------------------------------------------
verify_toolchain() {
    local problems=()
    if [ -z "${MPI_BIN:-}" ]; then
        problems+=("MPI_BIN is unset or empty")
    else
        local wrapper
        for wrapper in mpicc mpicxx; do
            [ -x "$MPI_BIN/$wrapper" ] || \
                problems+=("no executable MPI wrapper at $MPI_BIN/$wrapper")
        done
    fi
    local var
    for var in CC CXX; do
        [ -x "${!var:-}" ] || problems+=("$var='${!var:-}' is not an executable")
    done
    for var in BOOST_INC NETCDF_INC; do
        [ -d "${!var:-}" ] || problems+=("$var='${!var:-}' is not a directory")
    done

    if [ ${#problems[@]} -gt 0 ]; then
        echo "ERROR: the build environment is incomplete after loading module '$MODULE_NAME':" >&2
        local p
        for p in "${problems[@]}"; do echo "  - $p" >&2; done
        echo >&2
        echo "  MPI_BIN=${MPI_BIN:-UNSET}" >&2
        echo "  CC=${CC:-UNSET}" >&2
        echo "  CXX=${CXX:-UNSET}" >&2
        echo "  BOOST_INC=${BOOST_INC:-UNSET}" >&2
        echo "  NETCDF_INC=${NETCDF_INC:-UNSET}" >&2
        echo "  LCM_TOOLCHAIN_MPI_BIN=${LCM_TOOLCHAIN_MPI_BIN:-UNSET}" >&2
        echo >&2
        echo "Run 'lcm env' to see the whole resolved environment. On a CEE LAN" >&2
        echo "machine this usually means a module loaded by your .bashrc owns one" >&2
        echo "of these variable names; start from a clean shell and retry." >&2
        exit 1
    fi
}

# On CEE LAN machines (hpws*, cee-*), load the AUE compiler/MPI/TPL stack.
# The AUE modulefiles are NOT on the default MODULEPATH here (the SEMS init
# leaves plain Tcl Environment Modules and does not add them), so we add the
# tree explicitly with 'module use'.  We use the rhel8 AUE deploy: it carries
# the complete set (gcc, openmpi, cmake, boost, hdf5, netcdf-c) and its
# binaries run on both rhel8 and rhel9, whereas the rhel9 AUE tree currently
# ships only compilers/MPI (no boost/hdf5/netcdf-c).  These modules set
# BOOST_ROOT/NETCDF_ROOT, which we turn into the concrete *_INC/*_LIB vars the
# LCM modulefiles and CMake config consume; those plain exports survive the
# later 'module purge' in load_module.
AUE_TREE=/projects/aue/modules/cee/x86_64/rhel8
HN=$(hostname)
case "$HN" in
    hpws*|cee-*)
        if [ ! -d "$AUE_TREE" ]; then
            echo "ERROR: CEE AUE module tree not found: $AUE_TREE"
            exit 1
        fi
        # Load without aborting on a single miss so we can report clearly.
        set +e
        module use "$AUE_TREE"
        module load aue/gcc/12.3.0
        module load aue/openmpi/4.1.6-gcc-12.3.0
        module load aue/cmake/3.31.6
        module load aue/boost/1.85.0-gcc-12.3.0-openmpi-4.1.6
        module load aue/hdf5/1.14.3-gcc-12.3.0-openmpi-4.1.6
        module load aue/netcdf-c/4.9.2-gcc-12.3.0-openmpi-4.1.6
        set -e
        # Fail loudly if the toolchain did not come up, instead of letting a
        # later CMake configure fail cryptically.
        if ! command -v mpicxx >/dev/null 2>&1 || [ -z "${BOOST_ROOT:-}" ] || [ -z "${NETCDF_ROOT:-}" ]; then
            echo "ERROR: CEE AUE toolchain failed to load from $AUE_TREE"
            echo "  mpicxx: $(command -v mpicxx || echo MISSING)"
            echo "  BOOST_ROOT=${BOOST_ROOT:-UNSET}  NETCDF_ROOT=${NETCDF_ROOT:-UNSET}"
            exit 1
        fi
        # Record the toolchain under LCM_TOOLCHAIN_* names.
        #
        # These are the authoritative copy. The plain names below (CC, MPI_BIN,
        # BOOST_INC, ...) are what the LCM modulefiles and CMake read, but they
        # are ordinary environment variables that any modulefile may own: the
        # 'module purge' in load_module unloads whatever the calling shell had
        # loaded, and unloading a module that sets one of these names UNSETS it,
        # taking our value with it. An empty MPI_BIN then reaches CMake as
        # '-DCMAKE_CXX_COMPILER=/mpicxx', which is the failure this guards
        # against. Nothing in any module tree touches the LCM_TOOLCHAIN_*
        # names, so restore_toolchain can put the real values back afterwards.
        LCM_TOOLCHAIN_PATH="$(dirname $(which ld)):$(dirname $(which gcc)):$(dirname $(which mpicc)):$(dirname $(which cmake))"
        LCM_TOOLCHAIN_LD_LIBRARY_PATH="$(dirname $(which gcc))/../lib64:$(dirname $(which mpicc))/../lib"
        LCM_TOOLCHAIN_CC="$(which gcc)"
        LCM_TOOLCHAIN_CXX="$(which g++)"
        LCM_TOOLCHAIN_FC="$(which gfortran)"
        LCM_TOOLCHAIN_MPI_BIN="$(dirname "$(which mpicc)")"
        LCM_TOOLCHAIN_BOOST_ROOT="$BOOST_ROOT"
        LCM_TOOLCHAIN_NETCDF_ROOT="$NETCDF_ROOT"
        export LCM_TOOLCHAIN_PATH LCM_TOOLCHAIN_LD_LIBRARY_PATH \
               LCM_TOOLCHAIN_CC LCM_TOOLCHAIN_CXX LCM_TOOLCHAIN_FC \
               LCM_TOOLCHAIN_MPI_BIN LCM_TOOLCHAIN_BOOST_ROOT \
               LCM_TOOLCHAIN_NETCDF_ROOT
        # Now publish them under the names the modulefiles read, so that the
        # 'module load' in load_module sees them and propagates them too.
        restore_toolchain
        # Keep the LCM modulefiles on MODULEPATH for the later 'module load'.
        export MODULEPATH="$LCM_DIR/LCM/doc/lcm/modulefiles${MODULEPATH:+:$MODULEPATH}"
        ;;
esac

#---------------------------------------------------------------------------
# Parse arguments: extract commands, package, threads, and flags.
# Commands (clean, config, build, test) can be chained.
# Package and thread count are positional; flags start with --.
#---------------------------------------------------------------------------
COMMANDS=()
PACKAGE=""
THREADS="$(nproc)"
CDASH="OFF"
CTEST_VERBOSITY="-VV"
TEST_FILTER=""

for arg in "$@"; do
    case "$arg" in
        --module=*)
            MODULE_NAME="${arg#--module=}"
            ;;
        --cdash)
            CDASH="ON"
            ;;
        --quiet|-q)
            CTEST_VERBOSITY="-V"
            ;;
        --filter=*)
            TEST_FILTER="${arg#--filter=}"
            ;;
        --help|-h)
            COMMANDS=(help)
            ;;
        clean|config|build|test|all|env|help)
            COMMANDS+=("$arg")
            ;;
        trilinos|lcm)
            PACKAGE="$arg"
            ;;
        [0-9]*)
            THREADS="$arg"
            ;;
    esac
done

# Default to help if no commands given
if [ ${#COMMANDS[@]} -eq 0 ]; then
    COMMANDS=(help)
fi

#---------------------------------------------------------------------------
# Help
#---------------------------------------------------------------------------
show_help() {
    cat <<'HELPTEXT'
LCM Build System CLI

Usage: lcm <commands...> <package> [threads] [options]

Commands (can be chained):
  clean                    Clean build (and install for trilinos) directories
  config                   Configure package
  build                    Build package with N threads (default: nproc)
  test                     Run tests for package
  all                      Full pipeline: clean + config + build + test
                           Builds trilinos then lcm
  env                      Load the module and print the resolved build
                           environment (compilers, MPI, TPLs). Runs nothing
                           else; use it when a configure fails with a
                           nonsense compiler or TPL path.
  help, --help, -h         Show this help

Packages:
  trilinos                 Trilinos
  lcm                      LCM/Albany

Options:
  --module=<name>          Module to load (default: release)
  --cdash                  Submit results to CDash
  --quiet, -q              Reduce ctest verbosity (-V instead of -VV)
  --filter=<regex>         Run only tests matching regex (passed to ctest INCLUDE)

Environment:
  LCM_DIR                  Workspace root (auto-detected if unset)
  LCM_MODULE               Module to load (default: release)

Examples:
  lcm clean trilinos                         # clean only
  lcm config build lcm 168                   # configure + build
  lcm clean config build lcm 32              # clean + configure + build
  lcm clean config build test lcm 168        # full pipeline for lcm
  lcm test lcm                               # test only
  lcm env                                    # show the build environment
  lcm all 168                                # full pipeline (trilinos + lcm)
  lcm all 168 --module=serial-clang-release
  lcm all 168 --cdash -q
HELPTEXT
}

#---------------------------------------------------------------------------
# Validate package argument
#---------------------------------------------------------------------------
validate_package() {
    if [ -z "$PACKAGE" ]; then
        echo "ERROR: Package argument required. Use 'trilinos' or 'lcm'."
        exit 1
    fi
    case "$PACKAGE" in
        trilinos|lcm) ;;
        *)
            echo "ERROR: Unknown package '$PACKAGE'. Use 'trilinos' or 'lcm'."
            exit 1
            ;;
    esac
}

#---------------------------------------------------------------------------
# Load module and report environment
#---------------------------------------------------------------------------
load_module() {
    module purge 2>/dev/null || true
    module load "$MODULE_NAME"
    # 'module purge' just unloaded whatever the calling shell had loaded, which
    # can strip the toolchain's PATH entries and unset the variables that name
    # its compilers. Put the recorded values back before anything reads them.
    restore_toolchain
    verify_toolchain
    echo "Module:      $MODULE_NAME"
    echo "LCM_DIR:     $LCM_DIR"
    echo "ARCH:        ${ARCH:-unset}"
    echo "TOOL_CHAIN:  ${TOOL_CHAIN:-unset}"
    echo "BUILD_TYPE:  ${BUILD_TYPE:-unset}"
    echo "Threads:     $THREADS"
    echo "MPI_BIN:     ${MPI_BIN:-unset}"
    echo "CXX:         ${CXX:-unset}"
    echo "cmake:       $(command -v cmake || echo NOT FOUND)"
}

#---------------------------------------------------------------------------
# Run ctest -S with explicit -D flags
#---------------------------------------------------------------------------
run_ctest() {
    local CLEAN_BUILD="${1:-OFF}"
    local DO_CONFIG="${2:-OFF}"
    local DO_BUILD="${3:-OFF}"
    local DO_TEST="${4:-OFF}"

    local BUILD_SCRIPT="$LCM_DIR/LCM/doc/lcm/build/lcm-build.cmake"

    if [ ! -f "$BUILD_SCRIPT" ]; then
        echo "ERROR: Cannot find $BUILD_SCRIPT"
        exit 1
    fi

    cd "$LCM_DIR"

    echo "Running: ctest $CTEST_VERBOSITY -S lcm-build.cmake"
    echo "  PACKAGE=$PACKAGE  CLEAN_BUILD=$CLEAN_BUILD"
    echo "  DO_CONFIG=$DO_CONFIG  DO_BUILD=$DO_BUILD  DO_TEST=$DO_TEST"
    echo "  BUILD_THREADS=$THREADS"

    local BUILD_ID_STRING="${ARCH}-${TOOL_CHAIN}-${BUILD_TYPE}"
    # LCM_BUILD_SUFFIX gives a variant configuration its own build and
    # install directories; must match lcm-build.cmake.
    if [ -n "${LCM_BUILD_SUFFIX:-}" ]; then
        BUILD_ID_STRING="${BUILD_ID_STRING}-${LCM_BUILD_SUFFIX}"
    fi
    local PREFIX="${PACKAGE}-${BUILD_ID_STRING}"
    local LOG_FILE="$LCM_DIR/${PREFIX}.log"

    ctest $CTEST_VERBOSITY --timeout 180 -S "$BUILD_SCRIPT" \
        -DPACKAGE:STRING="$PACKAGE" \
        -DBUILD_THREADS:STRING="$THREADS" \
        -DCLEAN_BUILD:BOOL="$CLEAN_BUILD" \
        -DDO_CONFIG:BOOL="$DO_CONFIG" \
        -DDO_BUILD:BOOL="$DO_BUILD" \
        -DDO_TEST:BOOL="$DO_TEST" \
        -DCTEST_DO_SUBMIT:BOOL="$CDASH" \
        -DTEST_FILTER:STRING="$TEST_FILTER" \
        2>&1 | tee "$LOG_FILE"

    # Report failure to the caller. Piping to tee made this function always
    # return 0, so a failed configure or build still looked like success.
    #
    # ctest's own exit code cannot be used directly: in -S script mode it
    # exits 255 on a perfectly good build simply because the script ran no
    # tests. The authoritative result is the one lcm-build.cmake prints,
    # "lcm_do_package returned \"N\"", so key on that and fall back to
    # ctest's status only when the script never got far enough to print it.
    local ctest_rc=${PIPESTATUS[0]}
    local pkg_rc
    pkg_rc=$(sed -n 's/.*lcm_do_package returned "\([-0-9]*\)".*/\1/p' "$LOG_FILE" | tail -1)

    if [ -z "$pkg_rc" ]; then
        echo "ERROR: ctest -S $BUILD_SCRIPT produced no package result for '$PACKAGE'" \
             "(ctest exit $ctest_rc); see $LOG_FILE" >&2
        return "${ctest_rc:-1}"
    fi
    if [ "$pkg_rc" -ne 0 ]; then
        echo "ERROR: $PACKAGE failed (lcm_do_package returned $pkg_rc); see $LOG_FILE" >&2
        return 1
    fi
    return 0
}

#---------------------------------------------------------------------------
# Command dispatch
#---------------------------------------------------------------------------

# Handle help and all as special cases
for CMD in "${COMMANDS[@]}"; do
    if [ "$CMD" = "help" ]; then
        show_help
        exit 0
    fi
    if [ "$CMD" = "env" ]; then
        # Load the module and report the resolved build environment without
        # running anything. This is the first thing to run when a configure
        # fails with a nonsense compiler or TPL path.
        load_module
        echo
        echo "Resolved toolchain:"
        for v in CC CXX FC MPI_BIN MPI_INC MPI_LIB \
                 BOOST_INC BOOST_LIB NETCDF NETCDF_INC NETCDF_LIB \
                 INSTALL_DIR CXXFLAGS LCM_CXX_FLAGS; do
            printf '  %-14s %s\n' "$v" "${!v:-unset}"
        done
        echo
        echo "Tools on PATH:"
        for t in cmake ctest gcc g++ mpicc mpicxx; do
            printf '  %-14s %s\n' "$t" "$(command -v $t || echo NOT FOUND)"
        done
        exit 0
    fi
    if [ "$CMD" = "all" ]; then
        load_module
        echo "=== Full pipeline: trilinos + lcm ==="

        echo "--- Trilinos: clean + config + build ($THREADS threads) ---"
        PACKAGE=trilinos
        run_ctest ON ON ON OFF

        echo "--- LCM: clean + config + build + test ($THREADS threads) ---"
        PACKAGE=lcm
        run_ctest ON ON ON ON

        echo "=== Full pipeline complete ==="
        exit 0
    fi
done

# For chained commands, build up the flags and run once
validate_package
load_module

DO_CLEAN=OFF
DO_CONFIG=OFF
DO_BUILD=OFF
DO_TEST=OFF

for CMD in "${COMMANDS[@]}"; do
    case "$CMD" in
        clean)  DO_CLEAN=ON ;;
        config) DO_CONFIG=ON ;;
        build)  DO_BUILD=ON ;;
        test)   DO_TEST=ON ;;
    esac
done

echo "--- $PACKAGE: clean=$DO_CLEAN config=$DO_CONFIG build=$DO_BUILD test=$DO_TEST ($THREADS threads) ---"
run_ctest $DO_CLEAN $DO_CONFIG $DO_BUILD $DO_TEST
